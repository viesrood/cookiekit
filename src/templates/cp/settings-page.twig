{% extends '_layouts/cp' %}

{% set title = 'Settings'|t('cookiekit') %}
{% set selectedSubnavItem = 'settings' %}
{% set readOnly = readOnly ?? false %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
    {% if not readOnly %}
        {{ actionInput('plugins/save-plugin-settings') }}
        {{ hiddenInput('pluginHandle', 'cookiekit') }}
        {{ redirectInput('cookiekit/settings') }}
    {% endif %}

    {{ settingsHtml|raw }}
{% endblock %}
